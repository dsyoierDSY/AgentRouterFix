# Address exposed to Cherry Studio / OpenCode. Keep this on loopback unless
# you intentionally provide your own authentication and network protection.
HOST=127.0.0.1
PORT=8787

# Copy the OpenAI-compatible base URL shown in your AgentRouter dashboard.
# Examples must include any version prefix required by the provider, such as /v1.
UPSTREAM_BASE_URL=https://REPLACE_WITH_YOUR_AGENTROUTER_OPENAI_BASE_URL

# Automatic upstream recovery (enabled by default):
# 1. configured AgentRouter URL directly
# 2. official alternate domain directly, preserving the API path
# 3. both endpoints through the system HTTP(S) proxy after network failures
UPSTREAM_FALLBACK_BASE_URLS=https://ps.air-outer.com
SYSTEM_PROXY_FALLBACK=true
UPSTREAM_CONNECT_TIMEOUT_MS=10000

# Usually leave this empty: HTTPS_PROXY / HTTP_PROXY / ALL_PROXY and Windows
# Internet Settings are detected automatically. Set an HTTP(S) proxy URL here
# only when automatic detection is unsuitable. NO_PROXY is honored.
SYSTEM_PROXY_URL=

# The proxy passes the OpenCode request headers through unchanged, including
# Authorization and User-Agent. Configure the AgentRouter API key in OpenCode
# exactly as you did before; do not place it in this file.
#
# Leave this empty for transparent header pass-through. Set it only if you
# intentionally require a separate local proxy password in addition to the
# OpenCode Authorization header.
LOCAL_PROXY_API_KEY=

# Cherry Studio compatibility:
# - true (default): Cherry requests get OpenCode-compatible identifying headers,
#   while Cherry's Authorization header remains unchanged.
# A built-in compatible profile is used immediately; OpenCode is not required.
# If an actual OpenCode request happens to reach the proxy, its safe identifying
# headers can refresh the optional local profile automatically.
CHERRY_USE_OPENCODE_PROFILE=true
CLIENT_HEADER_PROFILE_FILE=.client-header-profile.json

# true: drop only malformed, out-of-band billing.summary SSE events.
# false: transparently pass every SSE event through (useful for diagnosis).
DROP_BILLING_SSE=true

# Optional. Output diagnostic messages locally; secrets are redacted.
LOG_LEVEL=info
